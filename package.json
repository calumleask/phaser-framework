{
  "name": "phaser-framework",
  "version": "1.0.0",
  "description": "",
  "main": "./dist/phfw.js",
  "module": "./src/index.ts",
  "files": [
    "dist",
    "src",
    "types"
  ],
  "scripts": {
    "clean": "node -e \"const fs=require('node:fs'); const path=require('node:path'); const target=path.resolve('dist'); if(path.dirname(target)!==process.cwd()) throw Error('Unexpected dist path'); fs.rmSync(target,{recursive:true,force:true})\"",
    "test": "npm run test:lint && npm run typecheck && npm run test:unit",
    "test:lint": "eslint --ext .ts src -c .eslintrc",
    "test:unit": "echo \"Error: no test specified\" && exit 1",
    "typecheck": "tsc --noEmit",
    "dev": "webpack --config webpack.dev.js --progress",
    "watch": "webpack --config webpack.dev.js --progress --watch",
    "start": "npm run watch",
    "build": "webpack --config webpack.prod.js --progress && npm run ts:defs",
    "ts:defs": "tsc -p tsconfig.types.json",
    "format": "prettier --write src"
  },
  "author": "Calum Leask",
  "license": "ISC",
  "packageManager": "npm@12.2.0",
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": ">=12.2.0 <13"
  },
  "dependencies": {
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "@babel/preset-typescript": "7.29.7",
    "@typescript-eslint/eslint-plugin": "8.71.1",
    "@typescript-eslint/parser": "8.71.1",
    "babel-loader": "10.1.1",
    "eslint": "8.57.1",
    "eslint-config-prettier": "^8.5.0",
    "prettier": "^2.7.1",
    "terser-webpack-plugin": "5.6.1",
    "typescript": "5.9.3",
    "webpack": "5.111.1",
    "webpack-cli": "7.2.3",
    "webpack-merge": "6.0.1"
  },
  "types": "./types/phfw.d.ts"
}
